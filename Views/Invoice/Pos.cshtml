@model List<QuanLyKho.Models.Entities.Product>
@{
    ViewData["Title"] = "Điểm Bán Hàng - POS";
    var categories = ViewBag.Categories as List<QuanLyKho.Models.Entities.Category> ?? new List<QuanLyKho.Models.Entities.Category>();
}

<div class="row g-3">
    <!-- Cột trái: Tìm kiếm, lọc và danh sách thẻ sản phẩm -->
    <div class="col-lg-7 col-xl-8">
        <div class="card border-0 shadow-sm h-100 d-flex flex-column">
            <!-- Thanh tìm kiếm & lọc danh mục -->
            <div class="card-header bg-white py-3 border-bottom px-3">
                <div class="row g-2">
                    <div class="col-md-7">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                            <input type="text" id="posSearchInput" class="form-control border-start-0 ps-0" placeholder="Tìm tên, mã SP hoặc quét mã vạch (F2)..." autofocus />
                        </div>
                    </div>
                    <div class="col-md-5">
                        <select id="posCategorySelect" class="form-select bg-light" onchange="filterProducts()">
                            <option value="">-- Tất cả nhóm hàng --</option>
                            @foreach (var c in categories)
                            {
                                <option value="@c.CategoryId">@c.Name</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <!-- Lưới hiển thị mặt hàng -->
            <div class="card-body p-3 overflow-auto" style="max-height: calc(100vh - 240px); min-height: 480px;">
                <div class="row g-3" id="productGrid">
                    @foreach (var p in Model)
                    {
                        <div class="col-6 col-md-4 col-xl-3 product-card-col" 
                             data-id="@p.ProductId" 
                             data-code="@p.ProductCode" 
                             data-barcode="@(p.Barcode ?? "")" 
                             data-name="@p.Name.ToLower()" 
                             data-cat="@p.CategoryId" 
                             data-price="@p.SalePrice" 
                             data-stock="@p.StockQuantity"
                             data-unit="@(p.Unit?.Name ?? "")">
                            <div class="card h-100 border text-start shadow-sm position-relative rounded-3 p-2 d-flex flex-column justify-content-between overflow-hidden" 
                                 onclick="addToCart(@p.ProductId)" 
                                 style="cursor: pointer; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); background-color: #ffffff;"
                                 onmouseover="this.style.transform='translateY(-3px)'; this.style.boxShadow='0 10px 20px rgba(0,0,0,0.08)';"
                                 onmouseout="this.style.transform='none'; this.style.boxShadow='';">
                                <div>
                                    <!-- Hình ảnh sản phẩm -->
                                    <div class="position-relative overflow-hidden rounded-2 mb-2 bg-light d-flex align-items-center justify-content-center" style="height: 110px;">
                                        @if (!string.IsNullOrWhiteSpace(p.ImageUrl))
                                        {
                                            <img src="@p.ImageUrl" alt="@p.Name" class="w-100 h-100" style="object-fit: cover; transition: transform 0.3s ease;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'" onerror="this.style.display='none'; this.nextElementSibling.classList.remove('d-none');" />
                                            <div class="d-none text-muted d-flex flex-column align-items-center justify-content-center w-100 h-100">
                                                <i class="bi bi-box-seam fs-1 text-secondary opacity-50"></i>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-secondary opacity-50 d-flex flex-column align-items-center justify-content-center w-100 h-100">
                                                <i class="bi bi-box-seam fs-1"></i>
                                            </div>
                                        }
                                        <span class="position-absolute top-0 start-0 m-1 badge bg-dark bg-opacity-75 font-monospace" style="font-size: 0.65rem;">@p.ProductCode</span>
                                        <div class="position-absolute top-0 end-0 m-1">
                                            @if (p.StockQuantity <= p.MinimumStock)
                                            {
                                                <span class="badge bg-danger shadow-sm fw-bold" style="font-size: 0.65rem;">
                                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>Tồn: @p.StockQuantity
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success shadow-sm fw-bold" style="font-size: 0.65rem;">
                                                    Tồn: @p.StockQuantity
                                                </span>
                                            }
                                        </div>
                                    </div>

                                    <h6 class="fw-bold text-dark text-truncate-2 mb-1" style="font-size: 0.85rem; min-height: 2.2rem; line-height: 1.25; overflow: hidden;" title="@p.Name">
                                        @p.Name
                                    </h6>
                                </div>
                                <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-1">
                                    <span class="fw-bold text-primary fs-6">@p.SalePrice.ToString("N0") <small class="text-muted" style="font-size: 0.7rem;">đ</small></span>
                                    <span class="badge bg-light text-muted border" style="font-size: 0.7rem;">@(p.Unit?.Name ?? "")</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Cột phải: Giỏ hàng, Chiết khấu & Nút Thanh Toán -->
    <div class="col-lg-5 col-xl-4">
        <div class="card border-0 shadow-sm h-100 d-flex flex-column">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center px-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="rounded-2 p-1 bg-success-subtle text-success">
                        <i class="bi bi-cart-check fs-5"></i>
                    </span>
                    <h6 class="fw-bold mb-0 text-dark">Hóa Đơn Bán Hàng</h6>
                </div>
                <button class="btn btn-sm btn-outline-danger" onclick="clearCart()" title="Xóa toàn bộ giỏ hàng">
                    <i class="bi bi-trash"></i> Xóa giỏ
                </button>
            </div>

            <!-- Bảng danh sách hàng trong giỏ -->
            <div class="card-body p-0 flex-grow-1 overflow-auto" style="max-height: 320px;">
                <table class="table table-hover align-middle mb-0" id="cartTable">
                    <thead class="table-light small">
                        <tr>
                            <th class="ps-3" style="width: 45%;">Mặt hàng</th>
                            <th class="text-center" style="width: 25%;">SL</th>
                            <th class="text-end pe-3" style="width: 30%;">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody id="cartItemsContainer">
                        <tr id="emptyCartRow">
                            <td colspan="3" class="text-center py-5 text-muted">
                                <i class="bi bi-cart-x fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                Chưa có sản phẩm trong giỏ<br>
                                <small>Nhấp chọn sản phẩm ở khung bên trái</small>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Khu vực tính tiền & xác nhận thanh toán -->
            <div class="card-footer bg-light p-3 border-top">
                <!-- Chọn Khách Hàng (CRM) -->
                <div class="mb-3 p-2 bg-white rounded border position-relative">
                    <label class="form-label small fw-bold text-muted mb-1 d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-person-fill text-primary me-1"></i>Khách hàng (CRM):</span>
                        <button type="button" class="btn btn-link p-0 text-decoration-none small text-primary fw-bold" data-bs-toggle="modal" data-bs-target="#quickAddCustomerModal">
                            <i class="bi bi-person-plus-fill me-1"></i>+ Thêm nhanh KH
                        </button>
                    </label>
                    <div id="customerSelectedBox" class="d-none alert alert-info py-1 px-2 mb-1 d-flex justify-content-between align-items-center">
                        <div class="small">
                            <strong id="custNameDisplay"></strong> <span id="custBadge" class="badge bg-warning text-dark ms-1"></span>
                            <div class="text-muted" style="font-size: 0.72rem;" id="custPhoneDisplay"></div>
                        </div>
                        <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-2" onclick="clearSelectedCustomer()" title="Hủy chọn khách"><i class="bi bi-x-circle"></i></button>
                    </div>
                    <div id="customerSearchGroup">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                            <input type="text" id="custSearchInput" class="form-control" placeholder="Tìm theo tên hoặc SĐT..." autocomplete="off" oninput="onSearchCustomer(this.value)">
                        </div>
                        <div id="custSearchResults" class="list-group position-absolute w-100 shadow-sm d-none" style="z-index: 1050; max-height: 180px; overflow-y: auto; left: 0;"></div>
                    </div>
                </div>

                <!-- Tạm tính -->
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted small">Tạm tính:</span>
                    <span class="fw-semibold text-dark" id="cartSubtotalText">0 đ</span>
                </div>

                <!-- Giảm giá (Strategy Pattern) -->
                <div class="mb-3 p-2 bg-white rounded border">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label small fw-bold text-muted mb-0">Chính sách giảm giá (Strategy):</label>
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <select id="discountTypeSelect" class="form-select form-select-sm" onchange="recalculateTotal()">
                                <option value="None">Không giảm</option>
                                <option value="Percentage">Giảm theo %</option>
                                <option value="Fixed">Giảm tiền mặt (đ)</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <input type="number" id="discountValueInput" class="form-control form-select-sm text-end" value="0" min="0" oninput="recalculateTotal()" />
                        </div>
                    </div>
                    <div class="d-flex justify-content-between mt-1 text-danger small">
                        <span>Tiền giảm:</span>
                        <span class="fw-semibold" id="cartDiscountText">- 0 đ</span>
                    </div>
                </div>

                <!-- Phương thức thanh toán -->
                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted mb-1">Hình thức thanh toán:</label>
                    <div class="btn-group w-100" role="group">
                        <input type="radio" class="btn-check" name="paymentMethod" id="payCash" value="TienMat" checked>
                        <label class="btn btn-outline-secondary btn-sm fw-semibold" for="payCash"><i class="bi bi-cash me-1"></i>Tiền mặt</label>

                        <input type="radio" class="btn-check" name="paymentMethod" id="payTransfer" value="ChuyenKhoan">
                        <label class="btn btn-outline-secondary btn-sm fw-semibold" for="payTransfer"><i class="bi bi-qr-code me-1"></i>Chuyển khoản</label>
                    </div>
                </div>

                <!-- Tổng thanh toán cuối cùng -->
                <div class="d-flex justify-content-between align-items-center py-2 border-top border-bottom mb-3">
                    <span class="fw-bold text-dark fs-6">TỔNG CỘNG:</span>
                    <span class="fw-bold text-success fs-4" id="cartTotalText">0 đ</span>
                </div>

                <!-- Nút xác nhận thanh toán -->
                <button class="btn btn-success w-100 py-3 fw-bold shadow-sm d-flex justify-content-center align-items-center gap-2" id="checkoutBtn" onclick="processCheckout()">
                    <i class="bi bi-check2-circle fs-5"></i> THANH TOÁN & IN HÓA ĐƠN
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thêm nhanh Khách hàng tại POS -->
<div class="modal fade" id="quickAddCustomerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h6 class="modal-title fw-bold"><i class="bi bi-person-plus-fill me-2"></i>Đăng Ký Nhanh Khách Hàng (CRM)</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-4">
                <div id="quickCustError" class="alert alert-danger py-2 small d-none"></div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Họ và tên khách hàng <span class="text-danger">*</span></label>
                    <input type="text" id="quickCustName" class="form-control" placeholder="Ví dụ: Lê Minh Hoàng" />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                    <input type="text" id="quickCustPhone" class="form-control" placeholder="Ví dụ: 0909888777" />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Nhóm khách hàng</label>
                    <select id="quickCustGroup" class="form-select">
                        <option value="Thường">Khách Thường (Tích điểm)</option>
                        <option value="VIP">Khách VIP (Ưu đãi giảm 5%)</option>
                        <option value="Bán buôn">Khách Bán buôn</option>
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-semibold">Địa chỉ</label>
                    <input type="text" id="quickCustAddress" class="form-control" placeholder="Ví dụ: Quận Tân Bình, TP.HCM" />
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary btn-sm fw-bold px-3" id="btnSaveQuickCust" onclick="saveQuickCustomer()">
                    <i class="bi bi-check2-circle me-1"></i> Lưu & Chọn Khách Này
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let cart = [];
    const productsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(p => new {
        id = p.ProductId,
        code = p.ProductCode,
        barcode = p.Barcode,
        name = p.Name,
        price = p.SalePrice,
        stock = p.StockQuantity,
        unit = p.Unit?.Name ?? "",
        image = p.ImageUrl ?? ""
    })));

    function addToCart(productId) {
        const prod = productsData.find(x => x.id === productId);
        if (!prod) return;

        const existing = cart.find(x => x.id === productId);
        if (existing) {
            if (existing.qty + 1 > prod.stock) {
                alert(`Sản phẩm "${prod.name}" chỉ còn ${prod.stock} trong kho!`);
                return;
            }
            existing.qty += 1;
        } else {
            if (prod.stock <= 0) {
                alert(`Sản phẩm "${prod.name}" hiện đã hết hàng trong kho!`);
                return;
            }
            cart.push({
                id: prod.id,
                code: prod.code,
                name: prod.name,
                price: prod.price,
                stock: prod.stock,
                unit: prod.unit,
                image: prod.image,
                qty: 1
            });
        }
        renderCart();
    }

    function updateCartQty(productId, newQty) {
        const item = cart.find(x => x.id === productId);
        if (!item) return;

        newQty = parseInt(newQty);
        if (isNaN(newQty) || newQty <= 0) {
            cart = cart.filter(x => x.id !== productId);
        } else {
            if (newQty > item.stock) {
                alert(`Số lượng vượt quá tồn kho hiện tại (${item.stock})!`);
                item.qty = item.stock;
            } else {
                item.qty = newQty;
            }
        }
        renderCart();
    }

    function clearCart() {
        if (cart.length === 0) return;
        if (confirm("Bạn có chắc chắn muốn hủy giỏ hàng hiện tại?")) {
            cart = [];
            renderCart();
        }
    }

    function renderCart() {
        const container = document.getElementById("cartItemsContainer");
        if (cart.length === 0) {
            container.innerHTML = `
                <tr id="emptyCartRow">
                    <td colspan="3" class="text-center py-5 text-muted">
                        <i class="bi bi-cart-x fs-1 d-block mb-2 text-secondary opacity-50"></i>
                        Chưa có sản phẩm trong giỏ<br>
                        <small>Nhấp chọn sản phẩm ở khung bên trái</small>
                    </td>
                </tr>
            `;
            recalculateTotal();
            return;
        }

        let html = "";
        cart.forEach(item => {
            const lineTotal = item.qty * item.price;
            html += `
                <tr>
                    <td class="ps-3">
                        <div class="d-flex align-items-center gap-2">
                            ${item.image ? `<img src="${item.image}" alt="" class="rounded border flex-shrink-0" style="width:36px;height:36px;object-fit:cover;" onerror="this.remove()" />` : `<div class="rounded bg-light border d-flex align-items-center justify-content-center text-secondary flex-shrink-0" style="width:36px;height:36px;"><i class="bi bi-box-seam" style="font-size:0.85rem;"></i></div>`}
                            <div class="overflow-hidden">
                                <div class="fw-bold small text-dark text-truncate" style="max-width: 130px;" title="${item.name}">${item.name}</div>
                                <div class="text-muted" style="font-size: 0.7rem;">${item.price.toLocaleString('vi-VN')} đ / ${item.unit}</div>
                            </div>
                        </div>
                    </td>
                    <td class="text-center">
                        <div class="input-group input-group-sm" style="width: 80px; margin: 0 auto;">
                            <input type="number" class="form-control text-center p-1" value="${item.qty}" min="1" max="${item.stock}" onchange="updateCartQty(${item.id}, this.value)" />
                        </div>
                    </td>
                    <td class="text-end pe-3">
                        <div class="fw-bold text-dark small">${lineTotal.toLocaleString('vi-VN')} đ</div>
                        <button class="btn btn-link text-danger p-0 border-0" style="font-size: 0.75rem;" onclick="updateCartQty(${item.id}, 0)">
                            <i class="bi bi-x-circle"></i> Xóa
                        </button>
                    </td>
                </tr>
            `;
        });
        container.innerHTML = html;
        recalculateTotal();
    }

    function recalculateTotal() {
        const subtotal = cart.reduce((sum, item) => sum + (item.qty * item.price), 0);
        document.getElementById("cartSubtotalText").innerText = subtotal.toLocaleString('vi-VN') + " đ";

        const discountType = document.getElementById("discountTypeSelect").value;
        const discountVal = parseFloat(document.getElementById("discountValueInput").value) || 0;
        let discountAmt = 0;

        if (discountType === "Percentage") {
            discountAmt = subtotal * (Math.min(100, Math.max(0, discountVal)) / 100);
        } else if (discountType === "FixedAmount") {
            discountAmt = Math.min(subtotal, Math.max(0, discountVal));
        }

        document.getElementById("cartDiscountText").innerText = "- " + discountAmt.toLocaleString('vi-VN') + " đ";
        const total = Math.max(0, subtotal - discountAmt);
        document.getElementById("cartTotalText").innerText = total.toLocaleString('vi-VN') + " đ";
    }

    function filterProducts() {
        const search = document.getElementById("posSearchInput").value.toLowerCase().trim();
        const cat = document.getElementById("posCategorySelect").value;
        const cols = document.querySelectorAll(".product-card-col");

        cols.forEach(col => {
            const name = col.getAttribute("data-name");
            const code = col.getAttribute("data-code").toLowerCase();
            const barcode = col.getAttribute("data-barcode").toLowerCase();
            const cId = col.getAttribute("data-cat");

            const matchSearch = !search || name.includes(search) || code.includes(search) || barcode.includes(search);
            const matchCat = !cat || cId === cat;

            if (matchSearch && matchCat) {
                col.style.display = "";
            } else {
                col.style.display = "none";
            }
        });
    }

    document.getElementById("posSearchInput").addEventListener("input", filterProducts);
    document.getElementById("posSearchInput").addEventListener("keydown", function(e) {
        if (e.key === "Enter") {
            const search = this.value.toLowerCase().trim();
            if (!search) return;
            const match = productsData.find(x => x.code.toLowerCase() === search || (x.barcode && x.barcode.toLowerCase() === search));
            if (match) {
                addToCart(match.id);
                this.value = "";
                filterProducts();
            }
        }
    });

    // Customer CRM logic
    let selectedCustomer = null;
    let searchDebounceTimer = null;

    function onSearchCustomer(val) {
        clearTimeout(searchDebounceTimer);
        const resultsEl = document.getElementById("custSearchResults");
        if (!val || val.trim().length < 2) {
            resultsEl.classList.add("d-none");
            resultsEl.innerHTML = "";
            return;
        }

        searchDebounceTimer = setTimeout(async () => {
            try {
                const resp = await fetch(`/Customer/SearchApi?term=${encodeURIComponent(val.trim())}`);
                const list = await resp.json();
                if (list && list.length > 0) {
                    let html = "";
                    list.forEach(c => {
                        html += `
                            <button type="button" class="list-group-item list-group-item-action py-2" onclick="selectCustomer(${JSON.stringify(c).replace(/"/g, '&quot;')})">
                                <div class="d-flex justify-content-between align-items-center">
                                    <strong class="small text-dark">${c.name}</strong>
                                    <span class="badge ${c.group === 'VIP' ? 'bg-warning text-dark' : 'bg-light text-dark border'}">${c.group}</span>
                                </div>
                                <div class="text-muted" style="font-size:0.75rem;">SĐT: ${c.phone} &bull; Điểm: ${c.points}</div>
                            </button>
                        `;
                    });
                    resultsEl.innerHTML = html;
                    resultsEl.classList.remove("d-none");
                } else {
                    resultsEl.innerHTML = `<div class="list-group-item small text-muted text-center py-2">Không tìm thấy khách hàng</div>`;
                    resultsEl.classList.remove("d-none");
                }
            } catch (err) {
                console.error(err);
            }
        }, 300);
    }

    function selectCustomer(c) {
        selectedCustomer = c;
        document.getElementById("custSearchResults").classList.add("d-none");
        document.getElementById("customerSearchGroup").classList.add("d-none");
        const box = document.getElementById("customerSelectedBox");
        box.classList.remove("d-none");
        document.getElementById("custNameDisplay").textContent = c.name;
        document.getElementById("custPhoneDisplay").textContent = `SĐT: ${c.phone} | Điểm: ${c.points}`;
        const badge = document.getElementById("custBadge");
        badge.textContent = c.group;
        badge.className = c.group === 'VIP' ? 'badge bg-warning text-dark ms-1' : 'badge bg-light text-dark border ms-1';

        // Auto apply VIP discount 5%
        if (c.group === "VIP") {
            const discType = document.getElementById("discountTypeSelect");
            const discVal = document.getElementById("discountValueInput");
            discType.value = "Percentage";
            discVal.value = 5;
            recalculateTotal();
        }
    }

    function clearSelectedCustomer() {
        selectedCustomer = null;
        document.getElementById("customerSelectedBox").classList.add("d-none");
        document.getElementById("customerSearchGroup").classList.remove("d-none");
        document.getElementById("custSearchInput").value = "";
    }

    async function saveQuickCustomer() {
        const name = document.getElementById("quickCustName").value.trim();
        const phone = document.getElementById("quickCustPhone").value.trim();
        const group = document.getElementById("quickCustGroup").value;
        const address = document.getElementById("quickCustAddress").value.trim();
        const errBox = document.getElementById("quickCustError");

        if (!name || !phone) {
            errBox.textContent = "Vui lòng nhập đầy đủ Họ tên và Số điện thoại.";
            errBox.classList.remove("d-none");
            return;
        }
        errBox.classList.add("d-none");

        const btn = document.getElementById("btnSaveQuickCust");
        btn.disabled = true;

        try {
            const resp = await fetch('/Customer/CreateQuickApi', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ FullName: name, PhoneNumber: phone, CustomerGroup: group, Address: address })
            });
            const data = await resp.json();
            if (data.success && data.customer) {
                selectCustomer(data.customer);
                const modalEl = document.getElementById('quickAddCustomerModal');
                const modalInstance = bootstrap.Modal.getInstance(modalEl);
                if (modalInstance) modalInstance.hide();
                document.getElementById("quickCustName").value = "";
                document.getElementById("quickCustPhone").value = "";
                document.getElementById("quickCustAddress").value = "";
            } else {
                errBox.textContent = data.message || "Không thể thêm khách hàng.";
                errBox.classList.remove("d-none");
            }
        } catch (err) {
            errBox.textContent = "Lỗi kết nối máy chủ: " + err;
            errBox.classList.remove("d-none");
        } finally {
            btn.disabled = false;
        }
    }

    // Close customer search dropdown when clicking outside
    document.addEventListener("click", function (e) {
        const group = document.getElementById("customerSearchGroup");
        if (group && !group.contains(e.target)) {
            document.getElementById("custSearchResults")?.classList.add("d-none");
        }
    });

    async function processCheckout() {
        if (cart.length === 0) {
            alert("Giỏ hàng đang trống! Vui lòng chọn sản phẩm trước khi thanh toán.");
            return;
        }

        const btn = document.getElementById("checkoutBtn");
        btn.disabled = true;
        btn.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span> Đang xử lý thanh toán...`;

        const payload = {
            CustomerId: selectedCustomer ? selectedCustomer.id : null,
            CustomerName: selectedCustomer ? selectedCustomer.name : null,
            CustomerPhone: selectedCustomer ? selectedCustomer.phone : null,
            Items: cart.map(x => ({ ProductId: x.id, Quantity: x.qty })),
            DiscountType: document.getElementById("discountTypeSelect").value,
            DiscountValue: parseFloat(document.getElementById("discountValueInput").value) || 0,
            PaymentMethod: document.querySelector('input[name="paymentMethod"]:checked').value
        };

        try {
            const resp = await fetch('/Invoice/Checkout', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await resp.json();
            if (data.success) {
                window.location.href = `/Invoice/Details/${data.invoiceId}`;
            } else {
                alert("Lỗi thanh toán: " + data.message);
                btn.disabled = false;
                btn.innerHTML = `<i class="bi bi-check2-circle fs-5 me-2"></i> THANH TOÁN & IN HÓA ĐƠN`;
            }
        } catch (err) {
            alert("Không thể kết nối máy chủ: " + err);
            btn.disabled = false;
            btn.innerHTML = `<i class="bi bi-check2-circle fs-5 me-2"></i> THANH TOÁN & IN HÓA ĐƠN`;
        }
    }
</script>
}
