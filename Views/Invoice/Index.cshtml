@model List<QuanLyKho.Models.Entities.Invoice>
@{
    ViewData["Title"] = "Lịch sử Hóa đơn";
    string? search = ViewBag.Search as string;
    string? status = ViewBag.Status as string;
    string? from = ViewBag.From as string;
    string? to = ViewBag.To as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-receipt text-primary me-2"></i>Lịch Sử Hóa Đơn Bán Hàng</h4>
        <p class="text-muted small mb-0">Tra cứu và quản lý các giao dịch bán lẻ (F.5.5, BR.06)</p>
    </div>
    <a asp-action="Pos" class="btn btn-success fw-semibold">
        <i class="bi bi-cart-plus-fill me-1"></i> Bán Hàng (POS)
    </a>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <input type="text" name="search" class="form-control" placeholder="Tìm theo mã HĐ, tên/SĐT khách..." value="@search" />
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select">
                    <option value="">-- Trạng thái --</option>
                    <option value="Completed" selected="@(status == "Completed")">Hoàn tất</option>
                    <option value="Cancelled" selected="@(status == "Cancelled")">Đã hủy</option>
                </select>
            </div>
            <div class="col-md-2">
                <input type="date" name="from" class="form-control" value="@from" placeholder="Từ ngày" />
            </div>
            <div class="col-md-2">
                <input type="date" name="to" class="form-control" value="@to" placeholder="Đến ngày" />
            </div>
            <div class="col-md-2 text-end">
                <button type="submit" class="btn btn-secondary w-100"><i class="bi bi-funnel me-1"></i> Lọc</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Mã Hóa Đơn</th>
                    <th>Thời gian</th>
                    <th>Khách hàng</th>
                    <th>Thu ngân</th>
                    <th>PTTT</th>
                    <th class="text-end">Tạm tính</th>
                    <th class="text-end">Giảm giá</th>
                    <th class="text-end">Tổng thanh toán</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-end pe-3">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="10" class="text-center py-4 text-muted">Không tìm thấy hóa đơn nào.</td></tr>
                }
                @foreach (var inv in Model)
                {
                    <tr>
                        <td class="ps-3 fw-bold text-primary">
                            <a asp-action="Details" asp-route-id="@inv.InvoiceId" class="text-decoration-none">
                                @inv.InvoiceCode
                            </a>
                        </td>
                        <td class="small text-muted">@inv.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(inv.CustomerName))
                            {
                                <div class="fw-semibold small">@inv.CustomerName</div>
                                @if (!string.IsNullOrEmpty(inv.CustomerPhone))
                                {
                                    <div class="text-muted" style="font-size: 0.75rem;">@inv.CustomerPhone</div>
                                }
                            }
                            else
                            {
                                <span class="text-muted small">Khách vãng lai</span>
                            }
                        </td>
                        <td class="small">@(inv.CreatedBy?.FullName ?? inv.CreatedBy?.UserName)</td>
                        <td>
                            <span class="badge @(inv.PaymentMethod == "TienMat" ? "bg-success-subtle text-success border border-success-subtle" : "bg-primary-subtle text-primary border border-primary-subtle")">
                                @(inv.PaymentMethod == "TienMat" ? "Tiền mặt" : "Chuyển khoản")
                            </span>
                        </td>
                        <td class="text-end small">@inv.Subtotal.ToString("N0") đ</td>
                        <td class="text-end text-danger small">-@inv.DiscountAmount.ToString("N0") đ</td>
                        <td class="text-end fw-bold text-success">@inv.TotalAmount.ToString("N0") đ</td>
                        <td class="text-center">
                            @if (inv.Status == "Completed")
                            {
                                <span class="badge bg-success">Hoàn tất</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Đã hủy</span>
                            }
                        </td>
                        <td class="text-end pe-3">
                            <a asp-action="Details" asp-route-id="@inv.InvoiceId" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye"></i> Xem
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
