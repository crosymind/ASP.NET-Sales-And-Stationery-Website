@model QuanLyKho.Models.Entities.Invoice
@{
    ViewData["Title"] = "Chi Tiết Hóa Đơn: " + Model.InvoiceCode;
    bool canReturn = Model.Status == "Completed" && (User.IsInRole("Admin") || User.IsInRole("BanHang"));
}

<div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h4 class="fw-bold mb-0">Hóa Đơn: @Model.InvoiceCode</h4>
            <span class="badge @(Model.Status == "Completed" ? "bg-success" : "bg-secondary") fs-6">
                @Model.Status
            </span>
        </div>
        <p class="text-muted small mb-0 mt-1">Giao dịch bán lẻ tại quầy Minh Anh Stationery</p>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
        <button type="button" class="btn btn-light border" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> In Hóa Đơn
        </button>
        @if (canReturn)
        {
            <a asp-controller="ReturnReceipt" asp-action="Create" asp-route-invoiceId="@Model.InvoiceId" class="btn btn-warning text-dark fw-bold">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Trả Hàng Theo Hóa Đơn (F.6.1)
            </a>
        }
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm p-4 p-md-5 bg-white" id="invoicePrintArea">
            <!-- Header Store Info -->
            <div class="text-center pb-4 mb-4 border-bottom">
                <h4 class="fw-bold mb-1">CỬA HÀNG VĂN PHÒNG PHẨM MINH ANH</h4>
                <div class="text-muted small">Địa chỉ: 123 Đường Văn Phòng, Quận Tân Bình, TP.HCM</div>
                <div class="text-muted small">Điện thoại: 028 3812 3456 &bull; Hotline: 0909 123 456</div>
                <h5 class="fw-bold text-primary mt-3 mb-1">HÓA ĐƠN BÁN HÀNG</h5>
                <div class="small fw-semibold text-secondary">Mã số: @Model.InvoiceCode</div>
            </div>

            <!-- Invoice Meta Information -->
            <div class="row g-2 mb-4 small">
                <div class="col-6">
                    <div><span class="text-muted">Ngày giờ bán:</span> <strong>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</strong></div>
                    <div><span class="text-muted">Thu ngân:</span> <strong>@(Model.CreatedBy?.FullName ?? Model.CreatedBy?.UserName)</strong></div>
                </div>
                <div class="col-6 text-end">
                    <div><span class="text-muted">Khách hàng:</span> <strong>@(string.IsNullOrEmpty(Model.CustomerName) ? "Khách lẻ" : Model.CustomerName)</strong></div>
                    @if (!string.IsNullOrEmpty(Model.CustomerPhone))
                    {
                        <div><span class="text-muted">SĐT:</span> <strong>@Model.CustomerPhone</strong></div>
                    }
                    <div><span class="text-muted">Phương thức:</span> <strong>@(Model.PaymentMethod == "TienMat" ? "Tiền mặt" : "Chuyển khoản")</strong></div>
                </div>
            </div>

            <!-- Items Table -->
            <div class="table-responsive mb-4">
                <table class="table table-sm align-middle mb-0">
                    <thead class="border-top border-bottom table-light small">
                        <tr>
                            <th class="py-2">Tên Mặt Hàng</th>
                            <th class="py-2 text-center">ĐVT</th>
                            <th class="py-2 text-center">SL</th>
                            <th class="py-2 text-end">Đơn Giá</th>
                            <th class="py-2 text-end">Thành Tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var itm in Model.Items)
                        {
                            <tr>
                                <td class="py-2">
                                    <div class="fw-semibold small">@itm.Product?.Name</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">Mã: @itm.Product?.ProductCode</div>
                                </td>
                                <td class="py-2 text-center small">@(itm.Product?.Unit?.Name ?? "-")</td>
                                <td class="py-2 text-center fw-bold">@itm.Quantity</td>
                                <td class="py-2 text-end small">@itm.UnitPrice.ToString("N0") đ</td>
                                <td class="py-2 text-end fw-semibold small">@itm.Subtotal.ToString("N0") đ</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pricing Summary -->
            <div class="row justify-content-end mb-4">
                <div class="col-sm-6">
                    <div class="d-flex justify-content-between small py-1 border-bottom">
                        <span class="text-muted">Tổng tạm tính:</span>
                        <strong class="text-dark">@Model.Subtotal.ToString("N0") đ</strong>
                    </div>
                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between small py-1 border-bottom text-danger">
                            <span>Giảm giá (@(Model.DiscountType == "Percentage" ? $"{Model.DiscountValue}%" : "Cố định")):</span>
                            <strong>-@Model.DiscountAmount.ToString("N0") đ</strong>
                        </div>
                    }
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="fw-bold fs-6">TỔNG THANH TOÁN:</span>
                        <span class="fw-bold fs-5 text-primary">@Model.TotalAmount.ToString("N0") đ</span>
                    </div>
                </div>
            </div>

            <!-- Return Receipts if any -->
            @if (Model.ReturnReceipts.Count > 0)
            {
                <div class="bg-light p-3 rounded border mb-4">
                    <div class="fw-bold small text-warning mb-2"><i class="bi bi-arrow-counterclockwise me-1"></i> Lịch sử trả hàng liên quan đến hóa đơn này:</div>
                    @foreach (var ret in Model.ReturnReceipts)
                    {
                        <div class="d-flex justify-content-between small mb-1">
                            <span>Phiếu trả: <a asp-controller="ReturnReceipt" asp-action="Details" asp-route-id="@ret.ReturnId">@ret.ReturnCode</a> (@ret.CreatedAt.ToString("dd/MM/yyyy HH:mm"))</span>
                            <strong class="text-danger">Đã hoàn: @ret.RefundAmount.ToString("N0") đ</strong>
                        </div>
                    }
                </div>
            }

            <div class="text-center pt-3 border-top small text-muted">
                <div><em>Cảm ơn Quý khách đã mua sắm tại Văn Phòng Phẩm Minh Anh!</em></div>
                <div>Quý khách vui lòng giữ hóa đơn khi có nhu cầu đổi trả hàng trong 07 ngày.</div>
            </div>
        </div>
    </div>
</div>
