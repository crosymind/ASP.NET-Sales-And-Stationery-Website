@using System.Security.Claims
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Minh Anh Stationery POS & ERP</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Custom Modern Styling -->
    <style>
        :root {
            --primary: #4f46e5;
            --primary-hover: #4338ca;
            --primary-light: #eef2ff;
            --secondary: #64748b;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --info: #06b6d4;
            --sidebar-bg: #0f172a;
            --sidebar-card: #1e293b;
            --sidebar-width: 270px;
            --sidebar-collapsed-width: 82px;
            --surface-bg: #f8fafc;
            --card-border: #e2e8f0;
            --text-heading: #0f172a;
            --text-body: #334155;
            --text-muted: #64748b;
            --radius-md: 12px;
            --radius-lg: 16px;
            --shadow-subtle: 0 1px 3px 0 rgb(0 0 0 / 0.05), 0 1px 2px -1px rgb(0 0 0 / 0.05);
            --shadow-card: 0 4px 6px -1px rgb(0 0 0 / 0.04), 0 2px 4px -2px rgb(0 0 0 / 0.04);
            --shadow-hover: 0 10px 15px -3px rgb(0 0 0 / 0.08), 0 4px 6px -4px rgb(0 0 0 / 0.04);
        }

        body {
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            background-color: var(--surface-bg);
            color: var(--text-body);
            letter-spacing: -0.01em;
        }

        /* Sidebar Styling */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            max-height: 100vh;
            background: linear-gradient(180deg, #0f172a 0%, #1e1b4b 100%);
            color: #e2e8f0;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            transition: all 0.3s ease;
            box-shadow: 4px 0 24px rgba(0, 0, 0, 0.12);
        }

        .sidebar .brand {
            padding: 1.15rem 1.25rem;
            display: flex;
            align-items: center;
            gap: 0.85rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            background: rgba(255, 255, 255, 0.02);
            flex-shrink: 0;
        }

        .sidebar .brand-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: linear-gradient(135deg, #6366f1 0%, #4338ca 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            color: #ffffff;
            box-shadow: 0 6px 12px rgba(99, 102, 241, 0.35);
            flex-shrink: 0;
        }

        .sidebar-toggle-row {
            display: flex;
            justify-content: flex-end;
            padding: 0.45rem 0.85rem 0.15rem;
            flex-shrink: 0;
        }

        .sidebar .sidebar-nav-container {
            flex: 1 1 auto;
            overflow-y: auto;
            overflow-x: hidden;
            width: 100%;
            padding-bottom: 3.5rem;
        }

        .sidebar .nav {
            display: flex;
            flex-direction: column;
            flex-wrap: nowrap !important;
            width: 100%;
        }

        .sidebar .sidebar-nav-container::-webkit-scrollbar {
            width: 5px;
        }
        .sidebar .sidebar-nav-container::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.1);
        }
        .sidebar .sidebar-nav-container::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 4px;
        }
        .sidebar .sidebar-nav-container::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.35);
        }

        .sidebar .nav-header {
            font-size: 0.68rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #94a3b8;
            padding: 0.95rem 1.25rem 0.25rem;
            font-weight: 700;
        }

        .sidebar .nav-link {
            color: #94a3b8;
            padding: 0.52rem 0.95rem;
            margin: 0.1rem 0.65rem;
            border-radius: 9px;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 0.865rem;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            white-space: nowrap;
        }

        .sidebar .nav-link:hover {
            color: #ffffff;
            background-color: rgba(255, 255, 255, 0.08);
            transform: translateX(3px);
        }

        .sidebar .nav-link.active {
            color: #ffffff;
            background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
            font-weight: 600;
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.35);
        }

        .sidebar .nav-link i {
            font-size: 1.05rem;
            width: 1.25rem;
            text-align: center;
            flex-shrink: 0;
        }

        body.sidebar-collapsed {
            --sidebar-width: var(--sidebar-collapsed-width);
        }

        .sidebar-collapsed .sidebar .brand {
            justify-content: center;
            padding-right: 0.5rem;
            padding-left: 0.5rem;
        }

        .sidebar-collapsed .sidebar .brand > div:not(.brand-icon),
        .sidebar-collapsed .sidebar .nav-header {
            display: none;
        }

        .sidebar-collapsed .sidebar .nav-link {
            justify-content: center;
            margin-right: 0.65rem;
            margin-left: 0.65rem;
            padding-right: 0.25rem;
            padding-left: 0.25rem;
            font-size: 0;
        }

        .sidebar-collapsed .sidebar .nav-link i {
            width: 1.5rem;
            flex-shrink: 0;
            font-size: 1.25rem;
        }

        .sidebar-toggle-row {
            display: flex;
            justify-content: flex-end;
            padding: 0.65rem 0.85rem 0.25rem;
        }

        .sidebar .sidebar-toggle {
            display: flex;
            align-items: center;
            justify-content: flex-start;
            gap: 0.7rem;
            width: 100%;
            padding: 0.55rem 0.75rem;
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 9px;
            background: rgba(255, 255, 255, 0.05);
            color: #cbd5e1;
            font-size: 0.8rem;
        }

        .sidebar .sidebar-toggle:hover,
        .sidebar .sidebar-toggle:focus-visible {
            border-color: rgba(255, 255, 255, 0.22);
            background: rgba(255, 255, 255, 0.1);
            color: #ffffff;
        }

        .sidebar .sidebar-toggle i {
            width: 1.3rem;
            flex-shrink: 0;
            text-align: center;
        }

        .sidebar-collapsed .sidebar-toggle-row {
            justify-content: center;
            padding-right: 0.65rem;
            padding-left: 0.65rem;
        }

        .sidebar-collapsed .sidebar .sidebar-toggle {
            justify-content: center;
            padding-right: 0.25rem;
            padding-left: 0.25rem;
        }

        .sidebar-collapsed .sidebar-toggle-label {
            display: none;
        }

        /* Layout Structure */
        .main-wrapper {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            transition: margin-left 0.3s ease;
        }

        /* Topbar */
        .top-navbar {
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            box-shadow: var(--shadow-subtle);
            border-bottom: 1px solid var(--card-border);
            padding: 0.85rem 2rem;
            position: sticky;
            top: 0;
            z-index: 990;
        }

        .content-body {
            padding: 1.75rem 2rem;
            flex: 1;
        }

        /* Modern Card Styling */
        .card {
            border: 1px solid var(--card-border);
            box-shadow: var(--shadow-card);
            border-radius: var(--radius-md);
            background-color: #ffffff;
            transition: box-shadow 0.2s ease, transform 0.2s ease;
        }

        .card.card-hover:hover {
            box-shadow: var(--shadow-hover);
            transform: translateY(-2px);
        }

        .card-header {
            background-color: #ffffff;
            border-bottom: 1px solid var(--card-border);
            font-weight: 700;
            padding: 1rem 1.25rem;
            border-top-left-radius: var(--radius-md) !important;
            border-top-right-radius: var(--radius-md) !important;
        }

        /* Modern Buttons */
        .btn {
            font-weight: 600;
            border-radius: 8px;
            padding: 0.5rem 1rem;
            letter-spacing: -0.01em;
            transition: all 0.2s ease;
        }

        .btn-primary {
            background-color: var(--primary);
            border-color: var(--primary);
        }

        .btn-primary:hover, .btn-primary:focus {
            background-color: var(--primary-hover);
            border-color: var(--primary-hover);
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.25);
        }

        .btn-success {
            background-color: var(--success);
            border-color: var(--success);
        }

        .btn-success:hover {
            background-color: #059669;
            border-color: #059669;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25);
        }

        /* Badges */
        .badge {
            font-weight: 600;
            padding: 0.35rem 0.65rem;
            border-radius: 6px;
        }

        .badge-role {
            font-size: 0.725rem;
            padding: 0.35rem 0.75rem;
            border-radius: 9999px;
            font-weight: 700;
            letter-spacing: 0.02em;
        }

        /* Table Styling */
        .table {
            color: var(--text-body);
        }

        .table thead th {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 700;
            color: var(--text-muted);
            border-bottom-width: 1px;
            background-color: #f8fafc;
            padding: 0.85rem 1rem;
        }

        .table tbody td {
            padding: 1rem;
            vertical-align: middle;
            border-bottom-color: #f1f5f9;
        }

        .table-hover tbody tr:hover {
            background-color: #f8fafc;
        }

        /* Inputs */
        .form-control, .form-select {
            border-radius: 8px;
            border-color: #cbd5e1;
            padding: 0.55rem 0.85rem;
            font-size: 0.925rem;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
        }

        /* Footer */
        .page-footer {
            background: #ffffff;
            border-top: 1px solid var(--card-border);
            padding: 1.25rem 2rem;
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        @@media print {
            body {
                background: #ffffff !important;
                color: #000000 !important;
            }
            .sidebar,
            .top-navbar,
            .page-footer,
            #toastContainer,
            .alert,
            .d-print-none {
                display: none !important;
            }
            .main-wrapper {
                margin-left: 0 !important;
                min-height: auto !important;
            }
            .content-body {
                padding: 0 !important;
                margin: 0 !important;
            }
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        var role = User.FindFirstValue(ClaimTypes.Role) ?? "";
        var fullName = User.FindFirst("FullName")?.Value ?? User.Identity.Name;

        <!-- Sidebar -->
        <aside class="sidebar" id="appSidebar">
            <div class="brand">
                <div class="brand-icon">
                    <i class="bi bi-box-seam-fill"></i>
                </div>
                <div class="overflow-hidden">
                    <div class="fw-bold fs-6 text-white text-uppercase text-truncate" style="letter-spacing: 0.04em;">Minh Anh Store</div>
                    <div class="small fw-semibold text-indigo-200 text-truncate" style="color: #a5b4fc; font-size: 0.75rem;">Hệ thống Quản lý Kho & Bán hàng</div>
                </div>
            </div>

            <div class="sidebar-toggle-row">
                <button type="button" class="sidebar-toggle" id="sidebarToggle" aria-label="Thu gọn thanh bên" aria-controls="appSidebar" aria-expanded="true" title="Thu gọn thanh bên">
                    <i class="bi bi-chevron-bar-left" aria-hidden="true"></i>
                    <span class="sidebar-toggle-label">Thu gọn thanh bên</span>
                </button>
            </div>

            <div class="sidebar-nav-container">
                <div class="nav flex-column py-1 flex-nowrap">
                <div class="nav-header">Tổng quan</div>
                <a class="nav-link" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2 text-info"></i> Dashboard
                </a>

                @if (role == "Admin" || role == "BanHang")
                {
                    <div class="nav-header">Bán Hàng (POS)</div>
                    <a class="nav-link" asp-controller="Invoice" asp-action="Pos">
                        <i class="bi bi-cart-plus-fill text-success"></i> Điểm bán hàng (POS)
                    </a>
                    <a class="nav-link" asp-controller="Invoice" asp-action="Index">
                        <i class="bi bi-receipt text-primary"></i> Lịch sử Hóa đơn
                    </a>
                    <a class="nav-link" asp-controller="ReturnReceipt" asp-action="Index">
                        <i class="bi bi-arrow-counterclockwise text-warning"></i> Trả hàng / Hoàn tiền
                    </a>
                    <a class="nav-link" asp-controller="Customer" asp-action="Index">
                        <i class="bi bi-people-fill text-info"></i> Khách hàng (CRM)
                    </a>
                }

                @if (role == "Admin" || role == "Kho" || role == "BanHang")
                {
                    <div class="nav-header">Hàng Hóa & Kho</div>
                    <a class="nav-link" asp-controller="Product" asp-action="Index">
                        <i class="bi bi-boxes text-info"></i> Danh mục Sản phẩm
                    </a>
                }

                @if (role == "Admin" || role == "Kho")
                {
                    <a class="nav-link" asp-controller="Product" asp-action="Categories">
                        <i class="bi bi-tags text-secondary"></i> Phân loại hàng
                    </a>
                    <a class="nav-link" asp-controller="Product" asp-action="Units">
                        <i class="bi bi-rulers text-secondary"></i> Đơn vị tính
                    </a>
                    <a class="nav-link" asp-controller="Supplier" asp-action="Index">
                        <i class="bi bi-truck text-secondary"></i> Nhà cung cấp
                    </a>
                    <a class="nav-link" asp-controller="PurchaseReceipt" asp-action="Index">
                        <i class="bi bi-box-arrow-in-down text-primary"></i> Nhập kho hàng
                    </a>
                    <a class="nav-link" asp-controller="Inventory" asp-action="Counts">
                        <i class="bi bi-clipboard-check text-warning"></i> Kiểm kê & Điều chỉnh
                    </a>
                    <a class="nav-link" asp-controller="Inventory" asp-action="Ledger">
                        <i class="bi bi-journal-text text-secondary"></i> Sổ kho (Thẻ kho)
                    </a>
                    <a class="nav-link" asp-controller="Inventory" asp-action="Alerts">
                        <i class="bi bi-exclamation-triangle-fill text-danger"></i> Cảnh báo tồn thấp
                    </a>
                }

                @if (role == "Admin")
                {
                    <div class="nav-header">Báo Cáo & Thống Kê</div>
                    <a class="nav-link" asp-controller="Report" asp-action="Revenue">
                        <i class="bi bi-graph-up-arrow text-success"></i> Doanh thu thuần
                    </a>
                    <a class="nav-link" asp-controller="Report" asp-action="Stock">
                        <i class="bi bi-pie-chart-fill text-info"></i> Báo cáo Giá trị tồn
                    </a>
                    <a class="nav-link" asp-controller="Report" asp-action="BestSellers">
                        <i class="bi bi-trophy-fill text-warning"></i> Sản phẩm bán chạy
                    </a>
                    <a class="nav-link" asp-controller="Report" asp-action="AuditLogs">
                        <i class="bi bi-shield-lock-fill text-secondary"></i> Nhật ký hệ thống
                    </a>

                    <div class="nav-header">Quản Trị</div>
                    <a class="nav-link" asp-controller="Account" asp-action="Users">
                        <i class="bi bi-people-fill text-primary"></i> Quản lý Người dùng
                    </a>
                }
                </div>
            </div>
        </aside>

        <!-- Main Content Area -->
        <div class="main-wrapper">
            <!-- Topbar -->
            <nav class="top-navbar d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-light text-dark border px-3 py-2 fs-7 fw-semibold">
                        <i class="bi bi-shop me-1 text-primary"></i> Minh Anh Stationery &bull; Chi nhánh Chính
                    </span>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <!-- 🔔 Notification Bell (SignalR) -->
                    <div class="dropdown" id="notifDropdown">
                        <button class="btn btn-sm btn-light border position-relative shadow-sm rounded-circle p-2" type="button"
                                id="notifBell" data-bs-toggle="dropdown" aria-expanded="false" title="Thông báo">
                            <i class="bi bi-bell-fill fs-5 text-warning"></i>
                            <span id="notifBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" style="font-size:0.65rem;">0</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 p-2 rounded-3"
                            id="notifList" style="min-width:320px;max-height:380px;overflow-y:auto;">
                            <li class="px-3 py-2 border-bottom mb-1 d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-dark small">Thông Báo Hệ Thống</span>
                                <button class="btn btn-sm btn-link text-muted p-0 small" onclick="clearNotifications()">Xóa tất cả</button>
                            </li>
                            <li id="notifEmpty" class="px-3 py-3 text-center text-muted small">
                                <i class="bi bi-check-circle text-success me-1"></i>Không có thông báo mới
                            </li>
                        </ul>
                    </div>

                    <div class="dropdown">
                        <button class="btn btn-sm btn-light border dropdown-toggle d-flex align-items-center gap-2 py-2 px-3 shadow-sm rounded-pill" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle fs-5 text-primary"></i>
                            <span class="fw-semibold">@fullName</span>
                            <span class="badge @(role == "Admin" ? "bg-danger" : (role == "Kho" ? "bg-primary" : "bg-success")) badge-role">
                                @role
                            </span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 p-2 rounded-3" style="min-width: 200px;">
                            <li class="px-3 py-2 border-bottom mb-1">
                                <div class="small text-muted">Tài khoản</div>
                                <div class="fw-bold text-dark">@User.Identity.Name</div>
                            </li>
                            <li><a class="dropdown-item rounded-2 py-2" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key me-2 text-secondary"></i>Đổi mật khẩu</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="dropdown-item rounded-2 py-2 text-danger fw-semibold"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>

            <!-- Content Body -->
            <main class="content-body">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success border-0 shadow-sm d-flex align-items-center alert-dismissible fade show mb-4 rounded-3" role="alert">
                        <i class="bi bi-check-circle-fill fs-5 text-success me-2"></i>
                        <div><strong>Thành công!</strong> @TempData["Success"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center alert-dismissible fade show mb-4 rounded-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-5 text-danger me-2"></i>
                        <div><strong>Lỗi!</strong> @TempData["Error"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>

            <!-- Modern Footer -->
            <footer class="page-footer d-flex justify-content-between align-items-center">
                <div>&copy; 2026 <strong>Cửa Hàng Văn Phòng Phẩm Minh Anh</strong> &bull; Hệ Thống Quản Lý Bán Hàng & Kho</div>
                <div class="badge bg-light text-muted border">Nhóm 02 &bull; ASP.NET Core MVC .NET 10 LTS</div>
            </footer>
        </div>
    }
    else
    {
        <main>
            @RenderBody()
        </main>
    }

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- SignalR Client -->
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script>
        // Auto active navigation link
        document.addEventListener('DOMContentLoaded', function () {
            const currentPath = window.location.pathname.toLowerCase();
            const toggleButton = document.getElementById('sidebarToggle');
            const sidebar = document.getElementById('appSidebar');
            const navLinks = sidebar ? sidebar.querySelectorAll('.nav-link') : [];
            const setSidebarCollapsed = function (collapsed) {
                document.body.classList.toggle('sidebar-collapsed', collapsed);

                if (toggleButton) {
                    const label = collapsed ? 'Mở rộng thanh bên' : 'Thu gọn thanh bên';
                    toggleButton.setAttribute('aria-expanded', String(!collapsed));
                    toggleButton.setAttribute('aria-label', label);
                    toggleButton.title = label;
                    const icon = toggleButton.querySelector('i');
                    if (icon) {
                        icon.classList.toggle('bi-chevron-bar-right', collapsed);
                        icon.classList.toggle('bi-chevron-bar-left', !collapsed);
                    }
                }

                navLinks.forEach(function (link) {
                    const label = link.textContent.trim().replace(/\s+/g, ' ');
                    if (collapsed) {
                        link.setAttribute('title', label);
                        link.setAttribute('aria-label', label);
                    } else {
                        link.removeAttribute('title');
                        link.removeAttribute('aria-label');
                    }
                });
            };

            let savedCollapsedState = false;
            try {
                savedCollapsedState = localStorage.getItem('minh-anh-sidebar-collapsed') === 'true';
            } catch (error) {
                // Continue with the default expanded sidebar if storage is unavailable.
            }
            setSidebarCollapsed(savedCollapsedState);

            if (toggleButton) {
                toggleButton.addEventListener('click', function () {
                    const collapsed = !document.body.classList.contains('sidebar-collapsed');
                    setSidebarCollapsed(collapsed);
                    try {
                        localStorage.setItem('minh-anh-sidebar-collapsed', String(collapsed));
                    } catch (error) {
                        // The toggle remains usable for this page even if storage is unavailable.
                    }
                });
            }

            const allNavLinks = Array.from(document.querySelectorAll('.sidebar .nav-link'));
            allNavLinks.forEach(link => link.classList.remove('active'));

            // 1. Kiểm tra khớp chính xác URL (Exact match)
            let matchedLink = allNavLinks.find(link => {
                const href = link.getAttribute('href')?.toLowerCase();
                if (!href) return false;
                if (currentPath === href) return true;
                if ((currentPath === '/' || currentPath === '') && (href === '/' || href === '/home' || href === '/home/index')) return true;
                return false;
            });

            // 2. Nếu không khớp chính xác (ví dụ trang con /Details/1), tìm link khớp tiền tố chi tiết nhất
            if (!matchedLink) {
                const candidates = allNavLinks.filter(link => {
                    const href = link.getAttribute('href')?.toLowerCase();
                    return href && href !== '/' && currentPath.startsWith(href.endsWith('/') ? href : href + '/');
                });
                if (candidates.length > 0) {
                    candidates.sort((a, b) => b.getAttribute('href').length - a.getAttribute('href').length);
                    matchedLink = candidates[0];
                }
            }

            if (matchedLink) {
                matchedLink.classList.add('active');
            }
        });
    </script>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Toast Container (SignalR real-time) -->
        <div id="toastContainer" class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 9999;"></div>

        <script>
        // ===== SignalR Real-time Notification =====
        let notifCount = 0;
        const notifications = [];

        function showToast(title, message, type) {
            const toastId = 'toast-' + Date.now();
            const bgClass = type === 'danger' ? 'text-bg-danger' : (type === 'success' ? 'text-bg-success' : 'text-bg-warning');
            const iconClass = type === 'danger' ? 'bi-exclamation-triangle-fill' : (type === 'success' ? 'bi-check-circle-fill' : 'bi-bell-fill');
            const html = `
            <div id="${toastId}" class="toast align-items-center ${bgClass} border-0 shadow mb-2" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="6000">
                <div class="d-flex">
                    <div class="toast-body d-flex align-items-center gap-2">
                        <i class="bi ${iconClass} fs-5"></i>
                        <div><strong class="d-block">${title}</strong><span class="small">${message}</span></div>
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>`;
            const container = document.getElementById('toastContainer');
            if (container) {
                container.insertAdjacentHTML('beforeend', html);
                const toastEl = document.getElementById(toastId);
                const toast = new bootstrap.Toast(toastEl);
                toast.show();
                toastEl.addEventListener('hidden.bs.toast', () => toastEl.remove());
            }
        }

        function addNotification(icon, title, text, alertClass) {
            notifCount++;
            notifications.unshift({ icon, title, text, alertClass, time: new Date() });
            renderNotifications();
        }

        function renderNotifications() {
            const badge = document.getElementById('notifBadge');
            const list = document.getElementById('notifList');
            const empty = document.getElementById('notifEmpty');
            if (!badge || !list || !empty) return;

            badge.textContent = notifCount > 9 ? '9+' : notifCount;
            badge.classList.toggle('d-none', notifCount === 0);
            empty.classList.toggle('d-none', notifications.length > 0);

            list.querySelectorAll('.notif-item').forEach(el => el.remove());

            notifications.slice(0, 10).forEach(n => {
                const timeStr = n.time.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
                const li = document.createElement('li');
                li.className = 'notif-item';
                li.innerHTML = `
                    <div class="dropdown-item rounded-2 py-2 px-3 ${n.alertClass} mb-1" style="white-space:normal;">
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi ${n.icon} mt-1 flex-shrink-0"></i>
                            <div>
                                <div class="fw-semibold small">${n.title}</div>
                                <div class="text-muted" style="font-size:0.78rem;">${n.text}</div>
                                <div class="text-muted" style="font-size:0.72rem;">${timeStr}</div>
                            </div>
                        </div>
                    </div>`;
                empty.insertAdjacentElement('afterend', li);
            });
        }

        function clearNotifications() {
            notifCount = 0;
            notifications.length = 0;
            renderNotifications();
        }

        if (typeof signalR !== 'undefined') {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl('/hubs/notification')
                .withAutomaticReconnect()
                .build();

            connection.on('LowStockAlert', (data) => {
                const msg = `Tồn kho: ${data.currentStock} / Ngưỡng tối thiểu: ${data.minimumStock}`;
                showToast('Cảnh báo tồn thấp', `${data.productName} – ${msg}`, 'danger');
                addNotification('bi-exclamation-triangle-fill text-danger', 'Cảnh báo tồn thấp', `${data.productName} – ${msg}`, 'bg-danger-subtle');
            });

            connection.on('StockRestored', (data) => {
                showToast('Tồn kho phục hồi', `${data.productName} – Tồn hiện tại: ${data.currentStock}`, 'success');
                addNotification('bi-check-circle-fill text-success', 'Tồn kho phục hồi', `${data.productName} – Tồn hiện tại: ${data.currentStock}`, 'bg-success-subtle');
            });

            connection.start().catch(err => console.warn('[SignalR] Không thể kết nối:', err));
        }
        </script>
    }
    @RenderSection("Scripts", required: false)
</body>
</html>
