@model List<QuanLyKho.Models.Entities.LowStockAlert>
@{
    ViewData["Title"] = "Cảnh báo Tồn kho thấp";
    string? status = ViewBag.Status as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>Cảnh Báo Tồn Kho Thấp</h4>
        <p class="text-muted small mb-0">Tự động phát hiện và cảnh báo khi tồn kho &le; ngưỡng tối thiểu (F.7.4, BR.09)</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="PurchaseReceipt" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-box-arrow-in-down me-1"></i> Tạo Phiếu Nhập Hàng
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <div class="d-flex gap-2">
            <a asp-action="Alerts" asp-route-status="Open" class="btn btn-sm @(status == "Open" ? "btn-danger fw-bold" : "btn-outline-danger")">
                Đang mở cảnh báo (@Model.Count(a => a.Status == "Open"))
            </a>
            <a asp-action="Alerts" asp-route-status="Closed" class="btn btn-sm @(status == "Closed" ? "btn-secondary fw-bold" : "btn-outline-secondary")">
                Đã đóng (Đã nhập thêm hàng)
            </a>
            <a asp-action="Alerts" asp-route-status="" class="btn btn-sm @(string.IsNullOrEmpty(status) ? "btn-dark fw-bold" : "btn-outline-dark")">
                Tất cả lịch sử
            </a>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Sản Phẩm</th>
                    <th>Danh mục</th>
                    <th class="text-center">Tồn Hiện Tại</th>
                    <th class="text-center">Ngưỡng Tối Thiểu</th>
                    <th class="text-center">Trạng Thái</th>
                    <th>Thời Điểm Mở Cảnh Báo</th>
                    <th>Thời Điểm Đóng</th>
                    <th class="text-end pe-3">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="8" class="text-center py-4 text-muted">Không có cảnh báo tồn kho nào. Mọi mặt hàng đang đạt mức an toàn!</td></tr>
                }
                @foreach (var a in Model)
                {
                    <tr>
                        <td class="ps-3">
                            <div class="fw-bold text-dark">@a.Product?.Name</div>
                            <div class="text-muted small" style="font-size: 0.75rem;">Mã: @a.Product?.ProductCode &bull; Barcode: @(a.Product?.Barcode ?? "-")</div>
                        </td>
                        <td>@(a.Product?.Category?.Name ?? "-")</td>
                        <td class="text-center">
                            <span class="badge @(a.CurrentStock <= a.MinimumStock ? "bg-danger fs-6 fw-bold" : "bg-success fs-6")">
                                @a.CurrentStock @(a.Product?.Unit?.Name ?? "")
                            </span>
                        </td>
                        <td class="text-center fw-semibold text-secondary">@a.MinimumStock</td>
                        <td class="text-center">
                            @if (a.Status == "Open")
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Đang mở (Nguy cấp)</span>
                            }
                            else
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Đã đóng</span>
                            }
                        </td>
                        <td class="small text-muted">@a.OpenedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="small text-muted">@(a.ClosedAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                        <td class="text-end pe-3">
                            <a asp-controller="PurchaseReceipt" asp-action="Create" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-cart-plus"></i> Nhập hàng
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
