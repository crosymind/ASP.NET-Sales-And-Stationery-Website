@model List<QuanLyKho.Models.Entities.Customer>
@{
    ViewData["Title"] = "Quản lý Khách hàng (CRM)";
    string? search = ViewBag.Search as string;
    string? group = ViewBag.Group as string;
    string? status = ViewBag.Status as string;

    int totalCount = ViewBag.TotalCount ?? Model.Count;
    int activeCount = ViewBag.ActiveCount ?? Model.Count(c => c.IsActive);
    int vipCount = ViewBag.VipCount ?? Model.Count(c => c.CustomerGroup == "VIP");
    int wholesaleCount = ViewBag.WholesaleCount ?? Model.Count(c => c.CustomerGroup == "Bán buôn");
    decimal totalSpentAll = ViewBag.TotalSpentAll ?? Model.Sum(c => c.TotalSpent);
    int totalPointsAll = ViewBag.TotalPointsAll ?? Model.Sum(c => c.Points);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-people-fill text-primary me-2"></i>Quản Lý Khách Hàng (CRM)</h4>
        <p class="text-muted small mb-0">Hồ sơ khách hàng, phân hạng thành viên, tích lũy điểm thưởng và lịch sử mua hàng</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportExcel" asp-route-search="@search" asp-route-group="@group" asp-route-status="@status" class="btn btn-success fw-semibold shadow-sm">
            <i class="bi bi-file-earmark-excel-fill me-1"></i> Xuất Excel
        </a>
        <a asp-action="Create" class="btn btn-primary fw-semibold shadow-sm">
            <i class="bi bi-person-plus-fill me-1"></i> Thêm Khách Hàng
        </a>
    </div>
</div>

<!-- KPI Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="rounded-3 bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-people-fill fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">Tổng Khách Hàng</div>
                    <h4 class="fw-bold mb-0">@totalCount <small class="fs-6 text-success fw-normal">(@activeCount hoạt động)</small></h4>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="rounded-3 bg-warning-subtle text-warning d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-star-fill fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">Khách VIP & Bán Buôn</div>
                    <h4 class="fw-bold mb-0">@vipCount VIP <small class="fs-6 text-info fw-normal">&bull; @wholesaleCount Sỉ</small></h4>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="rounded-3 bg-success-subtle text-success d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-cash-stack fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">Tổng Chi Tiêu Thành Viên</div>
                    <h4 class="fw-bold text-success mb-0">@totalSpentAll.ToString("N0") đ</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="rounded-3 bg-info-subtle text-info d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-award-fill fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">Tổng Điểm Tích Lũy</div>
                    <h4 class="fw-bold text-primary mb-0">@totalPointsAll.ToString("N0") pts</h4>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Search & Filter Form -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Tìm theo tên, mã KH, số điện thoại, email, địa chỉ..." value="@search" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="group" class="form-select">
                    <option value="">-- Tất cả nhóm khách --</option>
                    <option value="Thường" selected="@(group == "Thường")">Khách Thường</option>
                    <option value="VIP" selected="@(group == "VIP")">Khách VIP (Giảm 5%)</option>
                    <option value="Bán buôn" selected="@(group == "Bán buôn")">Khách Bán buôn (Giá sỉ)</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select">
                    <option value="">-- Trạng thái --</option>
                    <option value="active" selected="@(status == "active")">Đang hoạt động</option>
                    <option value="inactive" selected="@(status == "inactive")">Ngừng hoạt động</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-funnel me-1"></i> Lọc</button>
                @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(group) || !string.IsNullOrEmpty(status))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Xóa bộ lọc"><i class="bi bi-x-lg"></i></a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Customers Table -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Mã KH</th>
                    <th>Khách Hàng & Địa Chỉ</th>
                    <th>Số Điện Thoại</th>
                    <th>Nhóm Khách</th>
                    <th class="text-center">Điểm Tích Lũy</th>
                    <th class="text-end">Tổng Chi Tiêu</th>
                    <th class="text-center">Trạng Thái</th>
                    <th class="text-end pe-4">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-people fs-1 d-block mb-2 text-secondary"></i>
                            Không tìm thấy khách hàng nào phù hợp với điều kiện lọc.
                        </td>
                    </tr>
                }
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <a asp-action="Details" asp-route-id="@c.CustomerId" class="fw-bold text-primary text-decoration-none">
                                @c.CustomerCode
                            </a>
                        </td>
                        <td>
                            <div class="fw-bold text-dark">@c.FullName</div>
                            @if (!string.IsNullOrWhiteSpace(c.Address))
                            {
                                <div class="text-muted small"><i class="bi bi-geo-alt me-1"></i>@c.Address</div>
                            }
                            else if (!string.IsNullOrWhiteSpace(c.Email))
                            {
                                <div class="text-muted small"><i class="bi bi-envelope me-1"></i>@c.Email</div>
                            }
                        </td>
                        <td class="fw-semibold">
                            <i class="bi bi-telephone text-muted me-1"></i>@c.PhoneNumber
                        </td>
                        <td>
                            @if (c.CustomerGroup == "VIP")
                            {
                                <span class="badge bg-warning text-dark border border-warning"><i class="bi bi-star-fill me-1"></i>VIP (-5%)</span>
                            }
                            else if (c.CustomerGroup == "Bán buôn")
                            {
                                <span class="badge bg-info-subtle text-info border border-info-subtle">Bán buôn</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-dark border">Thường</span>
                            }
                        </td>
                        <td class="text-center">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-7 fw-bold">
                                @c.Points.ToString("N0") pts
                            </span>
                        </td>
                        <td class="text-end fw-bold text-success">
                            @c.TotalSpent.ToString("N0") đ
                        </td>
                        <td class="text-center">
                            @if (c.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Ngừng</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Details" asp-route-id="@c.CustomerId" class="btn btn-outline-info" title="Xem hồ sơ & lịch sử mua hàng">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@c.CustomerId" class="btn btn-outline-primary" title="Sửa thông tin">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="ToggleStatus" asp-route-id="@c.CustomerId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn đổi trạng thái hoạt động của khách hàng này?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-@(c.IsActive ? "warning" : "success")" title="@(c.IsActive ? "Ngừng hoạt động" : "Kích hoạt lại")">
                                        <i class="bi bi-@(c.IsActive ? "pause-circle" : "play-circle")"></i>
                                    </button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@c.CustomerId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa khách hàng này? (Chỉ xóa được khách chưa phát sinh hóa đơn)');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger" title="Xóa khách hàng">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
