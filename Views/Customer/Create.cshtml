@model QuanLyKho.Models.Entities.Customer
@{
    ViewData["Title"] = "Thêm Khách Hàng Mới";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h4 class="fw-bold mb-1"><i class="bi bi-person-plus-fill text-primary me-2"></i>Thêm Khách Hàng Mới</h4>
                <p class="text-muted small mb-0">Tạo mới thông tin khách hàng vào cơ sở dữ liệu CRM</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control" placeholder="Ví dụ: Nguyễn Văn An" required />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="Ví dụ: 0901234567" required />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold">Email</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="Ví dụ: an.nguyen@gmail.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CustomerGroup" class="form-label fw-semibold">Phân hạng nhóm khách</label>
                            <select asp-for="CustomerGroup" class="form-select">
                                <option value="Thường">Thường</option>
                                <option value="VIP">VIP (Ưu đãi 5%)</option>
                                <option value="Bán buôn">Bán buôn (Giá sỉ)</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label asp-for="Address" class="form-label fw-semibold">Địa chỉ liên hệ</label>
                            <input asp-for="Address" class="form-control" placeholder="Ví dụ: 123 Đường Cầu Giấy, Hà Nội" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Hủy</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            <i class="bi bi-save me-1"></i> Lưu Khách Hàng
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
