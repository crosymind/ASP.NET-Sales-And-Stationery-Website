@model List<QuanLyKho.Models.Entities.PurchaseReceipt>
@{
    ViewData["Title"] = "Quản lý Nhập kho";
    string? status = ViewBag.Status as string;
    string? from = ViewBag.From as string;
    string? to = ViewBag.To as string;
    bool canCreate = User.IsInRole("Admin") || User.IsInRole("Kho");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-box-arrow-in-down text-primary me-2"></i>Phiếu Nhập Kho</h4>
        <p class="text-muted small mb-0">Quản lý các đợt nhập hàng từ nhà cung cấp (F.4.1 - F.4.3, BR.05)</p>
    </div>
    @if (canCreate)
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Lập Phiếu Nhập Mới
        </a>
    }
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="Draft" selected="@(status == "Draft")">Nháp (Draft)</option>
                    <option value="Completed" selected="@(status == "Completed")">Hoàn tất (Completed)</option>
                    <option value="Cancelled" selected="@(status == "Cancelled")">Đã hủy (Cancelled)</option>
                </select>
            </div>
            <div class="col-md-3">
                <input type="date" name="from" class="form-control" value="@from" placeholder="Từ ngày" />
            </div>
            <div class="col-md-3">
                <input type="date" name="to" class="form-control" value="@to" placeholder="Đến ngày" />
            </div>
            <div class="col-md-3 text-end">
                <button type="submit" class="btn btn-secondary w-100"><i class="bi bi-funnel me-1"></i> Lọc dữ liệu</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Mã Phiếu</th>
                    <th>Nhà cung cấp</th>
                    <th>Thời gian lập</th>
                    <th>Người lập</th>
                    <th class="text-end">Tổng tiền hàng</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-end pe-3">Chi tiết</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-center py-4 text-muted">Không tìm thấy phiếu nhập nào.</td></tr>
                }
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="ps-3 fw-bold text-primary">
                            <a asp-action="Details" asp-route-id="@r.ReceiptId" class="text-decoration-none">
                                @r.ReceiptCode
                            </a>
                        </td>
                        <td class="fw-semibold">@r.Supplier?.Name</td>
                        <td class="small text-muted">@r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="small">@(r.CreatedBy?.FullName ?? r.CreatedBy?.UserName)</td>
                        <td class="text-end fw-bold">@r.TotalAmount.ToString("N0") đ</td>
                        <td class="text-center">
                            @if (r.Status == "Completed")
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Hoàn tất</span>
                            }
                            else if (r.Status == "Draft")
                            {
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Nháp</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Đã hủy</span>
                            }
                        </td>
                        <td class="text-end pe-3">
                            <a asp-action="Details" asp-route-id="@r.ReceiptId" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye"></i> Xem
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
