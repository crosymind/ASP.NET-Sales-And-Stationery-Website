@model QuanLyKho.Models.Entities.ReturnReceipt
@{
    ViewData["Title"] = "Chi Tiết Phiếu Trả: " + Model.ReturnCode;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h4 class="fw-bold mb-0">Phiếu Trả Hàng: @Model.ReturnCode</h4>
            <span class="badge bg-success fs-6">@Model.Status</span>
        </div>
        <p class="text-muted small mb-0 mt-1">Thông tin hoàn trả hàng theo hóa đơn bán lẻ (F.6.2, BR.15)</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
        <button type="button" class="btn btn-light border" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> In Phiếu
        </button>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h6 class="fw-bold text-primary mb-3">Thông Tin Hóa Đơn Gốc</h6>
                <div class="row g-2 small">
                    <div class="col-4 text-muted">Hóa đơn:</div>
                    <div class="col-8">
                        <a asp-controller="Invoice" asp-action="Details" asp-route-id="@Model.InvoiceId" class="fw-bold">
                            @Model.Invoice?.InvoiceCode
                        </a>
                    </div>
                    <div class="col-4 text-muted">Khách hàng:</div>
                    <div class="col-8">@(Model.Invoice?.CustomerName ?? "Khách lẻ")</div>
                    <div class="col-4 text-muted">Lý do trả hàng:</div>
                    <div class="col-8 fw-semibold text-danger">@Model.Reason</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h6 class="fw-bold text-primary mb-3">Thông Tin Hoàn Trả</h6>
                <div class="row g-2 small">
                    <div class="col-4 text-muted">Người xử lý:</div>
                    <div class="col-8 fw-semibold">@(Model.CreatedBy?.FullName ?? Model.CreatedBy?.UserName)</div>
                    <div class="col-4 text-muted">Thời điểm:</div>
                    <div class="col-8">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</div>
                    <div class="col-4 text-muted">Tổng tiền hoàn:</div>
                    <div class="col-8 fw-bold fs-5 text-danger">@Model.RefundAmount.ToString("N0") đ</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3">
        <h6 class="fw-bold mb-0">Mặt Hàng Khách Trả Lại (Đã Tăng Lại Tồn Kho)</h6>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">STT</th>
                    <th>Mã SP</th>
                    <th>Tên Sản Phẩm</th>
                    <th>ĐVT</th>
                    <th class="text-center">Số lượng trả</th>
                    <th class="text-end pe-3">Số tiền hoàn lại</th>
                </tr>
            </thead>
            <tbody>
                @{ int idx = 1; }
                @foreach (var it in Model.Items)
                {
                    <tr>
                        <td class="ps-3 text-muted">@(idx++)</td>
                        <td class="fw-semibold text-primary">@it.Product?.ProductCode</td>
                        <td class="fw-bold">@it.Product?.Name</td>
                        <td>@(it.Product?.Unit?.Name ?? "-")</td>
                        <td class="text-center fw-bold text-success">+@it.Quantity</td>
                        <td class="text-end pe-3 fw-bold text-danger">@it.RefundAmount.ToString("N0") đ</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
