@model List<QuanLyKho.Models.Entities.ReturnReceipt>
@{
    ViewData["Title"] = "Lịch sử Trả hàng";
    string? from = ViewBag.From as string;
    string? to = ViewBag.To as string;
    bool canCreate = User.IsInRole("Admin") || User.IsInRole("BanHang");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-arrow-counterclockwise text-primary me-2"></i>Phiếu Trả Hàng & Hoàn Tiền</h4>
        <p class="text-muted small mb-0">Quản lý các trường hợp khách trả hàng theo hóa đơn gốc (F.6.1, F.6.2, BR.14, BR.15)</p>
    </div>
    @if (canCreate)
    {
        <a asp-action="Create" class="btn btn-warning text-dark fw-bold">
            <i class="bi bi-plus-circle me-1"></i> Lập Phiếu Trả Hàng
        </a>
    }
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <input type="date" name="from" class="form-control" value="@from" placeholder="Từ ngày" />
            </div>
            <div class="col-md-5">
                <input type="date" name="to" class="form-control" value="@to" placeholder="Đến ngày" />
            </div>
            <div class="col-md-2 text-end">
                <button type="submit" class="btn btn-secondary w-100"><i class="bi bi-funnel me-1"></i> Lọc</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Mã Phiếu Trả</th>
                    <th>Hóa Đơn Gốc</th>
                    <th>Thời gian</th>
                    <th>Người xử lý</th>
                    <th>Lý do trả</th>
                    <th class="text-end">Tiền hoàn trả</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-end pe-3">Chi tiết</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="8" class="text-center py-4 text-muted">Không tìm thấy phiếu trả hàng nào.</td></tr>
                }
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="ps-3 fw-bold text-primary">
                            <a asp-action="Details" asp-route-id="@r.ReturnId" class="text-decoration-none">
                                @r.ReturnCode
                            </a>
                        </td>
                        <td>
                            <a asp-controller="Invoice" asp-action="Details" asp-route-id="@r.InvoiceId" class="fw-semibold text-secondary">
                                @r.Invoice?.InvoiceCode
                            </a>
                        </td>
                        <td class="small text-muted">@r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="small">@(r.CreatedBy?.FullName ?? r.CreatedBy?.UserName)</td>
                        <td class="small text-truncate" style="max-width: 200px;">@r.Reason</td>
                        <td class="text-end fw-bold text-danger">@r.RefundAmount.ToString("N0") đ</td>
                        <td class="text-center">
                            <span class="badge bg-success">Hoàn tất</span>
                        </td>
                        <td class="text-end pe-3">
                            <a asp-action="Details" asp-route-id="@r.ReturnId" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye"></i> Xem
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
