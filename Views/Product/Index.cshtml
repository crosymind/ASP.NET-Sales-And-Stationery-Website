@model List<QuanLyKho.Models.Entities.Product>
@{
    ViewData["Title"] = "Quản lý Sản phẩm";
    var categories = ViewBag.Categories as List<QuanLyKho.Models.Entities.Category> ?? new List<QuanLyKho.Models.Entities.Category>();
    int? currentCat = ViewBag.CategoryId as int?;
    bool showInactive = ViewBag.ShowInactive ?? false;
    string? search = ViewBag.Search as string;
    bool canEdit = User.IsInRole("Admin") || User.IsInRole("Kho");
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1 text-dark d-flex align-items-center gap-2">
            <span class="rounded-2 p-2 bg-primary-subtle text-primary d-inline-flex">
                <i class="bi bi-boxes"></i>
            </span>
            Danh Sách Sản Phẩm
        </h4>
        <p class="text-muted small mb-0">Quản lý danh mục hàng hóa, định giá bán, giá nhập và ngưỡng an toàn (F.2.1 - F.2.3)</p>
    </div>
    @if (canEdit)
    {
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary fw-bold shadow-sm d-flex align-items-center gap-2 px-3">
                <i class="bi bi-plus-circle-fill fs-6"></i> Thêm Mặt Hàng Mới
            </a>
        </div>
    }
</div>

<!-- Thanh tìm kiếm & bộ lọc -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control border-start-0 ps-0" placeholder="Tìm kiếm theo tên sản phẩm, mã SKU, mã vạch..." value="@search" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="categoryId" class="form-select bg-light">
                    <option value="">-- Tất cả nhóm hàng --</option>
                    @foreach (var c in categories)
                    {
                        if (currentCat == c.CategoryId)
                        {
                            <option value="@c.CategoryId" selected>@c.Name</option>
                        }
                        else
                        {
                            <option value="@c.CategoryId">@c.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <div class="form-check pt-1">
                    <input class="form-check-input" type="checkbox" name="showInactive" id="showInactive" value="true" @(showInactive ? "checked" : "") onchange="this.form.submit()" />
                    <label class="form-check-label small fw-semibold text-muted" for="showInactive">Bao gồm ngừng bán</label>
                </div>
            </div>
            <div class="col-md-2 text-end">
                <button type="submit" class="btn btn-secondary w-100 fw-semibold"><i class="bi bi-funnel-fill me-1"></i> Lọc dữ liệu</button>
            </div>
        </form>
    </div>
</div>

<!-- Bảng hiển thị sản phẩm -->
<div class="card border-0 shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-4">Mã SKU</th>
                    <th>Tên Sản Phẩm</th>
                    <th>Nhóm hàng</th>
                    <th class="text-center">ĐVT</th>
                    <th class="text-end">Giá nhập</th>
                    <th class="text-end">Giá bán</th>
                    <th class="text-center">Tồn kho</th>
                    <th class="text-center">Tối thiểu</th>
                    <th class="text-center">Trạng thái</th>
                    @if (canEdit)
                    {
                        <th class="text-end pe-4">Thao tác</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="10" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            Không tìm thấy sản phẩm nào phù hợp với điều kiện tìm kiếm.
                        </td>
                    </tr>
                }
                @foreach (var p in Model)
                {
                    bool isLowStock = p.StockQuantity <= p.MinimumStock;
                    <tr>
                        <td class="ps-4 fw-bold font-monospace text-primary">
                            @p.ProductCode
                            @if (!string.IsNullOrEmpty(p.Barcode))
                            {
                                <div class="text-muted fw-normal font-monospace" style="font-size: 0.725rem;"><i class="bi bi-upc-scan me-1"></i>@p.Barcode</div>
                            }
                        </td>
                        <td>
                            <div class="fw-bold text-dark">@p.Name</div>
                        </td>
                        <td><span class="badge bg-light text-secondary border">@p.Category?.Name</span></td>
                        <td class="text-center text-muted small">@(p.Unit?.Name ?? "-")</td>
                        <td class="text-end font-monospace text-muted">@p.PurchasePrice.ToString("N0") đ</td>
                        <td class="text-end font-monospace text-success fw-bold fs-6">@p.SalePrice.ToString("N0") đ</td>
                        <td class="text-center">
                            @if (isLowStock)
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-bold fs-6 px-2 py-1">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>@p.StockQuantity
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle fs-6 px-2 py-1">
                                    @p.StockQuantity
                                </span>
                            }
                        </td>
                        <td class="text-center text-muted small fw-semibold">@p.MinimumStock</td>
                        <td class="text-center">
                            @if (p.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Đang bán</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Ngừng bán</span>
                            }
                        </td>
                        @if (canEdit)
                        {
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@p.ProductId" class="btn btn-outline-secondary" title="Sửa thông tin sản phẩm">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="ToggleStatus" asp-route-id="@p.ProductId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn cập nhật trạng thái kinh doanh của sản phẩm này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-@(p.IsActive ? "danger" : "success")" title="@(p.IsActive ? "Ngừng kinh doanh" : "Kích hoạt lại")">
                                            <i class="bi bi-power"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
