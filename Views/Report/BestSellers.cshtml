@model List<QuanLyKho.Services.Interfaces.BestSellerDto>
@{
    ViewData["Title"] = "Báo Cáo Sản Phẩm Bán Chạy";
    string? from = ViewBag.From as string;
    string? to = ViewBag.To as string;
    int top = ViewBag.Top ?? 10;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-trophy text-warning me-2"></i>Sản Phẩm Bán Chạy</h4>
        <p class="text-muted small mb-0">Xếp hạng theo số lượng bán ròng trong kỳ (Số bán - Số trả) - F.8.3</p>
    </div>
    <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
        <i class="bi bi-printer me-1"></i> In Báo Cáo
    </button>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <input type="date" name="from" class="form-control" value="@from" placeholder="Từ ngày" />
            </div>
            <div class="col-md-4">
                <input type="date" name="to" class="form-control" value="@to" placeholder="Đến ngày" />
            </div>
            <div class="col-md-2">
                <select name="top" class="form-select">
                    <option value="5" selected="@(top == 5)">Top 5</option>
                    <option value="10" selected="@(top == 10)">Top 10</option>
                    <option value="20" selected="@(top == 20)">Top 20</option>
                </select>
            </div>
            <div class="col-md-2 text-end">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-filter me-1"></i> Xem</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3 text-center" style="width: 70px;">Hạng</th>
                    <th>Mã SP</th>
                    <th>Tên Sản Phẩm</th>
                    <th>Danh mục</th>
                    <th>ĐVT</th>
                    <th class="text-center">Số lượng bán</th>
                    <th class="text-center">Số lượng trả</th>
                    <th class="text-center">Bán ròng</th>
                    <th class="text-end pe-3">Doanh thu thu về</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="9" class="text-center py-4 text-muted">Chưa có giao dịch bán hàng nào trong khoảng thời gian này.</td></tr>
                }
                @{ int rank = 1; }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-3 text-center">
                            @if (rank == 1)
                            {
                                <span class="badge bg-warning text-dark fs-6"><i class="bi bi-trophy-fill"></i> 1</span>
                            }
                            else if (rank == 2)
                            {
                                <span class="badge bg-secondary fs-6">2</span>
                            }
                            else if (rank == 3)
                            {
                                <span class="badge bg-bronze fs-6" style="background-color: #cd7f32; color: white;">3</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-dark border">@rank</span>
                            }
                        </td>
                        <td class="fw-semibold text-primary">@item.ProductCode</td>
                        <td class="fw-bold">@item.ProductName</td>
                        <td>@(item.CategoryName)</td>
                        <td>@(item.UnitName)</td>
                        <td class="text-center fw-semibold text-primary">@item.QuantitySold</td>
                        <td class="text-center text-danger small">@(item.QuantityReturned > 0 ? $"-{item.QuantityReturned}" : "0")</td>
                        <td class="text-center fw-bold fs-6 text-success">@item.NetQuantitySold</td>
                        <td class="text-end pe-3 fw-bold text-dark">@item.TotalRevenue.ToString("N0") đ</td>
                    </tr>
                    rank++;
                }
            </tbody>
        </table>
    </div>
</div>
