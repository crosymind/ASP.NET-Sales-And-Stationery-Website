@model QuanLyKho.Services.Interfaces.RevenueReportDto
@{
    ViewData["Title"] = "Báo Cáo Doanh Thu Thuần";
    string? from = ViewBag.From as string;
    string? to = ViewBag.To as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-cash-stack text-success me-2"></i>Báo Cáo Doanh Thu Thuần</h4>
        <p class="text-muted small mb-0">Doanh thu thuần = Tổng hóa đơn hoàn tất - Tổng tiền hoàn trả hàng (F.8.1, BR.17)</p>
    </div>
    <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
        <i class="bi bi-printer me-1"></i> In Báo Cáo
    </button>
</div>

<!-- Date Filter Form -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <label class="form-label small fw-semibold">Từ ngày:</label>
                <input type="date" name="from" class="form-control" value="@from" />
            </div>
            <div class="col-md-5">
                <label class="form-label small fw-semibold">Đến ngày:</label>
                <input type="date" name="to" class="form-control" value="@to" />
            </div>
            <div class="col-md-2 text-end pt-4">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-filter me-1"></i> Xem Báo Cáo</button>
            </div>
        </form>
    </div>
</div>

<!-- Metrics Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 bg-primary-subtle text-primary border-primary">
            <div class="card-body">
                <div class="small text-uppercase fw-semibold">Tổng doanh thu bán hàng (@Model.TotalInvoiceCount hóa đơn)</div>
                <h3 class="fw-bold mt-2 mb-0">@Model.GrossRevenue.ToString("N0") đ</h3>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 bg-danger-subtle text-danger border-danger">
            <div class="card-body">
                <div class="small text-uppercase fw-semibold">Tiền hoàn trả hàng (@Model.TotalReturnCount phiếu trả)</div>
                <h3 class="fw-bold mt-2 mb-0">-@Model.TotalRefundAmount.ToString("N0") đ</h3>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 bg-success-subtle text-success border-success">
            <div class="card-body">
                <div class="small text-uppercase fw-semibold">DOANH THU THUẦN THỰC NHẬN</div>
                <h3 class="fw-bold mt-2 mb-0">@Model.NetRevenue.ToString("N0") đ</h3>
            </div>
        </div>
    </div>
</div>

<!-- Payment Breakdown -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3">
        <h6 class="fw-bold mb-0">Phân Bổ Theo Phương Thức Thanh Toán</h6>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <div class="p-3 border rounded d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small"><i class="bi bi-cash me-1 text-success"></i> Tiền mặt</div>
                        <h4 class="fw-bold text-dark mt-1 mb-0">@Model.CashAmount.ToString("N0") đ</h4>
                    </div>
                    <span class="badge bg-success fs-6">
                        @((Model.GrossRevenue > 0 ? (Model.CashAmount / Model.GrossRevenue * 100) : 0).ToString("N1"))%
                    </span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="p-3 border rounded d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small"><i class="bi bi-qr-code me-1 text-primary"></i> Chuyển khoản ngân hàng</div>
                        <h4 class="fw-bold text-dark mt-1 mb-0">@Model.BankTransferAmount.ToString("N0") đ</h4>
                    </div>
                    <span class="badge bg-primary fs-6">
                        @((Model.GrossRevenue > 0 ? (Model.BankTransferAmount / Model.GrossRevenue * 100) : 0).ToString("N1"))%
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>
